#include "ls2k300.dtsi"
#include "ls2k300_ddr_samsung_512m.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "earlycon";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bootparam: bootparam_region {
			reg = <0x90000000 0x0f000000 0x0 0x1000000>;
			no-map;
		};
	};

};

&spi0 {
	status = "okay";

	spi-flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <25000000>; /* input clock */
		reg = <0>; /* CS0 */
	};
};

&spi1 {
	status = "okay";
	/* CS is software-controlled via GPIO pin 99 (active low) */
	cs-gpios = <&gpio0 99 GPIO_ACTIVE_LOW>;

	spi-nand@0 {
		compatible = "spi-nand";
		spi-max-frequency = <25000000>; /* input clock */
		reg = <0>; /* CS index 0 -> cs-gpios[0] */
	};
};

&emmc0 {
	status = "disabled";
};
